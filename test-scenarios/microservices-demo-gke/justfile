# Justfile for GKE breakage scenarios

default:
    just -l

# Lists targets, this should be ON TOP.
list:
    just -l

# Deploy GKE Autopilot cluster & Online Boutique via embedded Terraform (zero sed hacks)
deploy:
    cd terraform && terraform init && terraform apply -var="gcp_project_id=${GOOGLE_CLOUD_PROJECT}"

clone-repo:
    #!/usr/bin/env bash
    if [ ! -d "microservices-demo" ]; then
        git clone https://github.com/GoogleCloudPlatform/microservices-demo.git
    else
        echo "Repository already exists."
    fi
    ln -sfn ../microservices-demo investigation/microservices-demo
    ln -sfn ../kustomize investigation/kustomize

# Destroy GKE Autopilot cluster & Online Boutique via embedded Terraform
destroy:
    cd terraform && terraform destroy -var="gcp_project_id=${GOOGLE_CLOUD_PROJECT}"

install: deploy

# Enter or display the spoiler-free investigation/ Root Cage folder
investigate:
    @echo "🕵️‍♂️ Start your AI agent (agy / gemini) inside the spoiler-free Root Cage:"
    @echo "  cd $(pwd)/investigation && agy"

# Verify zero circular/broken symlinks and zero symlinks on .md/.sh/.rb files, plus bash syntax check
test:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "🔍 [1/3] Checking for forbidden symlinks on .md/.sh/.rb files..."
    BAD_FILE_LINKS=$(find . -type l \( -name "*.md" -o -name "*.sh" -o -name "*.rb" \))
    if [ -n "$BAD_FILE_LINKS" ]; then
      echo "❌ ERROR: File symlinks are forbidden (causes ELOOP in startup scripts): $BAD_FILE_LINKS"
      exit 1
    fi
    echo "🔍 [2/3] Checking for circular or broken symlinks (find -xtype l)..."
    BROKEN_LINKS=$(find . -xtype l -not -name "microservices-demo")
    if [ -n "$BROKEN_LINKS" ]; then
      echo "❌ ERROR: Circular or broken symlinks detected: $BROKEN_LINKS"
      exit 1
    fi
    echo "🔍 [3/3] Checking bash syntax on all .sh scripts..."
    find . -name "*.sh" -exec bash -n {} +
    echo "✅ All symlink and syntax checks passed!"

clean:
    rm -rf microservices-demo/
    rm -rf breakage-scenarios/breakage1-checkout/microservices-demo/
    rm -rf breakage-scenarios/breakage2-canary/microservices-demo/

# Run the GKE Brokenness Monitor once
monitor-once:
    @bash bin/monitor.sh

# Real-time GKE Brokenness Monitor dashboard (wrapped in watch)
monitor-watch:
    @watch -n 2 -c "bash bin/monitor.sh" || while true; do clear; bash bin/monitor.sh; sleep 2; done

monitor: monitor-watch

# --- Scenario 1: Blackhole Checkout ---
break1:
    @echo "🚨 Introducing Scenario 1: Blackhole traffic to cart checkout"
    cd breakage-scenarios/breakage1-checkout && bash break.sh

fix1:
    @echo "🔧 Fixing Scenario 1: Restoring checkout traffic"
    cd breakage-scenarios/breakage1-checkout && bash fix.sh

check1:
    @echo "🔍 Checking Scenario 1 status..."
    cd breakage-scenarios/breakage1-checkout && bash check.sh

test1:
    @echo "🔍 Continually pinging Scenario 1 status (Ctrl+C to stop)..."
    cd breakage-scenarios/breakage1-checkout && bash test.sh

# --- Scenario 2: Buggy Canary Rollout ---
break2:
    @echo "🚨 Introducing Scenario 2: Buggy Frontend Canary Rollout"
    cd breakage-scenarios/breakage2-canary && bash break.sh

fix2:
    @echo "🔧 Fixing Scenario 2: Removing buggy canary deployment"
    cd breakage-scenarios/breakage2-canary && bash fix.sh

check2:
    @echo "🔍 Checking Scenario 2 status..."
    cd breakage-scenarios/breakage2-canary && bash check.sh

test2:
    @echo "🔍 Continually pinging Scenario 2 status (Ctrl+C to stop)..."
    cd breakage-scenarios/breakage2-canary && bash test.sh

# --- Scenario 3: VPC Firewall Block ---
break3:
    @echo "🚨 Introducing Scenario 3: VPC Firewall blocking frontend"
    cd breakage-scenarios/breakage3-firewall && bash break.sh

fix3:
    @echo "🔧 Fixing Scenario 3: Removing blocking firewall rule"
    cd breakage-scenarios/breakage3-firewall && bash fix.sh

check3:
    @echo "🔍 Checking Scenario 3 status..."
    cd breakage-scenarios/breakage3-firewall && bash check.sh

test3:
    @echo "🔍 Continually pinging Scenario 3 status (Ctrl+C to stop)..."
    cd breakage-scenarios/breakage3-firewall && bash test.sh

# --- Disaster Scenario ---
break-them-all-smoothly:
    just break1
    sleep 900
    just break2
    sleep 100
    just break3
